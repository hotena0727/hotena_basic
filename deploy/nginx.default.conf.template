server {
    listen ${PORT};
    server_name _;

    # --- 🔒 security: block dotfiles (.env, .git, etc.) ---
    # NOTE: Put these BEFORE the main proxy locations so they match first.
    location ~ /\.(?!well-known).* {
        return 404;
    }

    # --- 🔒 security: block .env anywhere in path (e.g., /.env, /foo/.env, /foo/.env/bar) ---
    location ~* \.env($|/) {
        return 404;
    }

    # (optional) block common sensitive project files
    location ~* /(composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|pnpm-lock\.yaml)$ {
        return 404;
    }

    location = /manifest.json {
        alias /app/static/pwa-manifest.json;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "no-store" always;
    }

    location = /sw.js {
        alias /app/static/sw.js;
        add_header Content-Type "application/javascript" always;
        add_header Cache-Control "no-store" always;
    }

    location = /push_register_snippet.js {
        alias /app/static/push_register_snippet.js;
        add_header Content-Type "application/javascript" always;
        add_header Cache-Control "no-store" always;
    }

    # (선택) 루트에서도 /pwa-manifest.json 접근 허용
    location = /pwa-manifest.json {
        alias /app/static/pwa-manifest.json;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "no-store" always;
    }


    # ✅ Streamlit이 쓰는 /static/* 는 반드시 Streamlit로 전달
    location /static/ {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400;
    }

    # (호환용) 루트에서도 아이콘 접근 가능
    location = /icon-192.png { alias /app/static/icon-192.png; add_header Cache-Control "public, max-age=86400" always; access_log off; }
    location = /icon-512.png { alias /app/static/icon-512.png; add_header Cache-Control "public, max-age=86400" always; access_log off; }
    location = /favicon.ico { alias /app/static/favicon.ico; add_header Cache-Control "public, max-age=86400" always; access_log off; }
    location = /apple-touch-icon.png { alias /app/static/apple-touch-icon.png; add_header Cache-Control "public, max-age=86400" always; access_log off; }

    location / {
        # ✅ HTML 캐시 방지(해시 불일치 재발 방지)
        add_header Cache-Control "no-store" always;

        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400;
    }
}
