server {
    listen ${PORT};
    server_name _;

    location = /manifest.json {
        alias /app/static/pwa-manifest.json;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /sw.js {
        alias /app/static/sw.js;
        add_header Content-Type "application/javascript" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /icon-192.png { alias /app/static/icon-192.png; add_header Cache-Control "public, max-age=86400"; }
    location = /icon-512.png { alias /app/static/icon-512.png; add_header Cache-Control "public, max-age=86400"; }
    location = /apple-touch-icon.png { alias /app/static/apple-touch-icon.png; add_header Cache-Control "public, max-age=86400"; }
    location = /favicon.ico { alias /app/static/favicon.ico; add_header Cache-Control "public, max-age=86400"; }

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400;
    }
}
