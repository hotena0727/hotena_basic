server {
    listen ${PORT};
    server_name _;

    # ✅ PWA manifest
    location = /manifest.json {
        alias /app/static/pwa-manifest.json;
        try_files /pwa-manifest.json =404;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "no-cache" always;
        access_log off;
    }

    # ✅ Service Worker (루트에서 제공)
    location = /sw.js {
        alias /app/static/sw.js;
        try_files /sw.js =404;
        add_header Content-Type "application/javascript" always;
        add_header Cache-Control "no-cache" always;
        access_log off;
    }

    # ✅ 루트 아이콘/파비콘
    location = /icon-192.png { alias /app/static/icon-192.png; try_files /icon-192.png =404; add_header Cache-Control "public, max-age=86400"; access_log off; }
    location = /icon-512.png { alias /app/static/icon-512.png; try_files /icon-512.png =404; add_header Cache-Control "public, max-age=86400"; access_log off; }
    location = /apple-touch-icon.png { alias /app/static/apple-touch-icon.png; try_files /apple-touch-icon.png =404; add_header Cache-Control "public, max-age=86400"; access_log off; }
    location = /favicon.ico { alias /app/static/favicon.ico; try_files /favicon.ico =404; add_header Cache-Control "public, max-age=86400"; access_log off; }

    # ✅ /static/* -> /app/static/*
    location ^~ /static/ {
        alias /app/static/;
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # ✅ 나머지는 앱으로 프록시
    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400;
    }
}
